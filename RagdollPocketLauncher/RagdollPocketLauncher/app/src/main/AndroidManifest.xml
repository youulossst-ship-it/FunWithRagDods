<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
    <queries>
        <package android:name="com.winlator"/>
        <package android:name="com.winlator.cmod"/>
        <package android:name="com.xiaoji.egggame"/>
        <package android:name="gamehub.lite"/>
    </queries>
    <application android:label="Ragdoll Pocket Launcher" android:theme="@style/Theme.App"
        android:allowBackup="false" android:requestLegacyExternalStorage="true">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity android:name=".ControlsActivity" android:screenOrientation="landscape"/>
    </application>
</manifest>
